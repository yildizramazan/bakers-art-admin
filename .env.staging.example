# Supply these through the staging deployment's environment manager.
# Next does not automatically load .env.staging; APP_ENV is separate from NODE_ENV.
APP_ENV=staging
# Required: the real, public HTTPS staging origin (no path or credentials).
APP_ORIGIN=
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never place a secret/service-role key in NEXT_PUBLIC_ variables.
