# Supply these through the production deployment's environment manager.
APP_ENV=production
# Required: the real, public HTTPS production origin (no path or credentials).
APP_ORIGIN=
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never place a secret/service-role key in NEXT_PUBLIC_ variables.
# Production configuration acceptance is not operational release acceptance.
